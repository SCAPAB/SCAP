{
  "name": "innehav",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Portföljsystem för institutionella investerare – aktier, fonder och PE-fonder",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --no-warnings --import tsx --watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "start": "NODE_ENV=production node --no-warnings --import tsx server/index.ts",
    "seed": "node --no-warnings --import tsx server/seed.ts",
    "test": "node --no-warnings --import tsx --test server/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "demo:docs": "node --no-warnings --import tsx scripts/demo-docs.ts",
    "demo": "npm run seed && npm run demo:docs",
    "dev:demo": "INNEHAV_AI_MOCK=data/demo-dokument/ai npm run dev"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "papaparse": "^5.7.1",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "pdf-lib": "^1.17.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
