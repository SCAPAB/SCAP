{
  "namn": "Fond i EUR – valutaeffekt när kronan försvagas",
  "beskrivning": "Köp 1 000 andelar à 10 EUR när EUR = 11,00 SEK → anskaffningsvärde 110 000 SEK. Per 2026-06-30 är kursen 12 EUR och EUR = 11,50 → marknadsvärde 1 000 × 12 × 11,5 = 138 000. Orealiserat 28 000, varav valutaeffekt 10 000 × 11,5 − 110 000 = 5 000.",
  "datum": "2026-06-30",
  "steg": [
    { "anrop": "POST /api/fx", "data": { "currency": "EUR", "date": "2026-01-15", "rate": 11.0 } },
    { "anrop": "POST /api/fx", "data": { "currency": "EUR", "date": "2026-06-30", "rate": 11.5 } },
    { "anrop": "POST /api/instruments", "data": { "type": "FUND", "name": "Testfond Europa A", "currency": "EUR", "fund_category": "Aktiefond", "region": "Europa" }, "spara": "fond" },
    { "anrop": "POST /api/transactions", "data": { "entity_id": 1, "instrument_id": "{{fond}}", "type": "BUY", "trade_date": "2026-01-15", "quantity": 1000, "price": 10, "amount": 10000, "fee": 0, "fx_rate": 11.0 } },
    { "anrop": "POST /api/prices", "data": { "instrument_id": "{{fond}}", "date": "2026-06-30", "price": 12 } }
  ],
  "kontroller": [
    { "namn": "Marknadsvärde i fondens valuta", "hamta": "GET /api/instruments/{{fond}}?asOf={{datum}}", "falt": "total.mvLocal", "forvantat": 12000 },
    { "namn": "Marknadsvärde i SEK", "hamta": "GET /api/instruments/{{fond}}?asOf={{datum}}", "falt": "total.mvBase", "forvantat": 138000 },
    { "namn": "Anskaffningsvärde i SEK med kursen på affärsdagen", "hamta": "GET /api/instruments/{{fond}}?asOf={{datum}}", "falt": "total.costBase", "forvantat": 110000 },
    { "namn": "Orealiserat resultat i SEK", "hamta": "GET /api/instruments/{{fond}}?asOf={{datum}}", "falt": "total.unrealizedBase", "forvantat": 28000 },
    { "namn": "Varav valutaeffekt", "hamta": "GET /api/instruments/{{fond}}?asOf={{datum}}", "falt": "total.fxEffectBase", "forvantat": 5000 },
    { "namn": "Fonden klassas som Noterade aktier", "hamta": "GET /api/portfolio/allocation?asOf={{datum}}", "falt": "rows[key=PUBLIC_EQUITY].value", "forvantat": 138000 }
  ]
}
