{
  "namn": "Fyra ögon avslaget – en tidigare attesterad transaktion kan ändras och tas bort som i dag",
  "beskrivning": "Förbättring 2026-11-15, F9. Ett kapitalanrop attesteras med fyra ögon påslaget (transaktion 2). Därefter stänger administratören av fyra ögon (det loggas). Då fungerar PUT och DELETE som i dag: investeringen ändras till 95 000 (inbetalt 100 000) och transaktionen tas sedan bort (inbetalt 0).",
  "datum": "2026-06-30",
  "steg": [
    { "anrop": "PUT /api/settings", "data": { "dual_control": true } },
    { "anrop": "POST /api/users", "data": { "email": "attestant@test.invalid", "name": "Test Attestant", "role": "editor", "password": "attest-12345" } },
    { "anrop": "POST /api/instruments", "data": { "type": "PE_FUND", "name": "Testfond Ändring I", "currency": "SEK", "strategy": "Buyout", "vintage": 2025, "manager": "Test GP" }, "spara": "pe" },
    { "anrop": "POST /api/transactions", "data": { "entity_id": 1, "instrument_id": "{{pe}}", "type": "COMMITMENT", "trade_date": "2025-01-01", "amount": 1000000 } },
    { "anrop": "POST /api/documents", "data": { "filename": "anrop-andring.pdf", "mime": "application/pdf", "data": "JVBERi0xLjQKJXRlc3RkYXRhIGZvciBzY2VuYXJpbyAyMwo=" }, "spara": "dok" },
    { "anrop": "POST /api/documents/{{dok}}/proposals", "data": { "kind": "CALL" }, "spara": "post" },
    { "anrop": "PUT /api/proposals/{{post}}", "data": { "entity_id": 1, "instrument_id": "{{pe}}", "fields": { "date": "2026-03-01", "amount": 105000, "fee": 5000, "currency": "SEK" } } },
    { "beskrivning": "Administratören granskar", "anrop": "POST /api/proposals/{{post}}/prepare", "data": {} },
    { "beskrivning": "Attestanten loggar in", "anrop": "POST /api/auth/login", "data": { "email": "attestant@test.invalid", "password": "attest-12345" } },
    { "beskrivning": "Attestanten godkänner (transaktion 2)", "anrop": "POST /api/proposals/{{post}}/approve", "data": {} },
    { "beskrivning": "Administratören loggar in igen", "anrop": "POST /api/auth/login", "data": { "email": "admin@innehav.local", "password": "innehav" } },
    { "beskrivning": "Fyra ögon stängs av", "anrop": "PUT /api/settings", "data": { "dual_control": false } },
    { "beskrivning": "Direkt ändring fungerar", "anrop": "PUT /api/transactions/2", "data": { "entity_id": 1, "instrument_id": "{{pe}}", "type": "CALL", "trade_date": "2026-03-01", "amount": 95000, "fee": 5000 } },
    { "beskrivning": "Direkt borttag fungerar", "anrop": "DELETE /api/transactions/2" }
  ],
  "kontroller": [
    { "namn": "Ändringen loggades med det nya beloppet", "hamta": "GET /api/audit", "falt": "[action=update].details", "innehaller": "95000" },
    { "namn": "Inbetalt 0 efter borttag", "hamta": "GET /api/instruments/{{pe}}?asOf={{datum}}", "falt": "total.paidIn", "forvantat": 0 }
  ]
}
